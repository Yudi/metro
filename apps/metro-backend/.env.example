# Private rail integration gRPC target. Docker Compose overrides this with its
# internal-only service alias; local development defaults to localhost:50051.
RAIL_INTEGRATION_GRPC_URL=localhost:50051
RAIL_INTEGRATION_GRPC_DEADLINE_MS=120000
RAIL_INTEGRATION_GRPC_READINESS_DEADLINE_MS=5000
RAIL_INTEGRATION_GRPC_MAX_ATTEMPTS=3
RAIL_INTEGRATION_GRPC_RETRY_DELAY_MS=250

# Optional Web Push. Configure all three to enable the notification queue.
# Generate once with: bun x web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
