# Backend
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:4200
SWAGGER_ENABLED=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379

# Public rail integration client settings
RAIL_INTEGRATION_GRPC_URL=localhost:50051
RAIL_INTEGRATION_GRPC_DEADLINE_MS=120000
RAIL_INTEGRATION_GRPC_READINESS_DEADLINE_MS=5000
RAIL_INTEGRATION_GRPC_MAX_ATTEMPTS=3
RAIL_INTEGRATION_GRPC_RETRY_DELAY_MS=250

# Optional public backend integrations
HEADWAY_ENABLED_LINES=L1,L2,L3
OLHOVIVO_API_TOKEN=replace-with-your-public-integration-token
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=typesense-api-key
FIREBASE_ADMIN_CREDENTIALS='{"projectId":"local-project","clientEmail":"local@example.com","privateKey":"-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n"}'

# Frontend SSR and end-to-end tests
HOST=localhost
BASE_URL=http://localhost:4200
