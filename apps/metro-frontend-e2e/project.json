{
  "name": "metro-frontend-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/metro-frontend-e2e/src",
  "implicitDependencies": ["metro-frontend"],
  "// targets": "to see all targets run: nx show project metro-frontend-e2e --web",
  "targets": {
    "notifications": {
      "executor": "nx:run-commands",
      "options": { "command": "bun x playwright test --config apps/metro-frontend-e2e/notifications.playwright.config.ts" }
    },
    "notification-stories": {
      "executor": "nx:run-commands",
      "options": { "command": "bun x playwright test --config apps/metro-frontend-e2e/notifications-storybook.playwright.config.ts" }
    }
  }
}
