{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "composite": true,
    "declaration": true,
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts",
    "generated/prisma/**/*.ts",
    "../../libs/shared/utils/src/**/*.ts",
    "../../libs/shared/environment/src/**/*.ts",
    "../../libs/shared/bike-contracts/src/**/*.ts",
    "../../libs/shared/rail-integration-contracts/src/**/*.ts"
  ],
  "exclude": [
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "../../libs/shared/**/src/**/*.spec.ts",
    "../../libs/shared/**/src/**/*.test.ts",
    "../../libs/shared/**/src/test-setup.ts"
  ]
}
