{
  "name": "metro-backend-e2e",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["metro-backend"],
  "targets": {
    "e2e": {
      "outputs": [
        "{workspaceRoot}/coverage/{e2eProjectRoot}",
        "{workspaceRoot}/coverage/metro-backend-e2e"
      ],
      "dependsOn": ["metro-backend:build", "metro-backend:serve"],
      "options": {
        "passWithNoTests": true
      },
      "configurations": {
        "ci": {
          "ci": true,
          "coverage": true
        }
      }
    }
  }
}
